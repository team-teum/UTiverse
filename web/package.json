{
	"name": "utiverse-web",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=26.13.1 <27",
		"npm": ">=11"
	},
	"scripts": {
		"dev": "vite",
		"dev:supabase": "node scripts/dev-supabase.mjs",
		"build": "tsc -b && vite build",
		"lint": "biome lint .",
		"typecheck": "tsc -b",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"check": "biome ci . && npm run typecheck",
		"test": "node --test",
		"preview": "vite preview",
		"deploy": "npm run build && wrangler deploy"
	},
	"dependencies": {
		"@supabase/supabase-js": "2.119.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router-dom": "^7.18.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.3.0",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"wrangler": "^4.162.0"
	}
}
